# API de gestión recetas - Pruebas manuales
#
# Cómo se utiliza:
#   1. Arranca la aplicación en el puerto 8080.
#   2. Abre este archivo en IntelliJ IDEA.
#   3. Pulsa "Run all requests in file", o ejecuta las peticiones una a una
#      de arriba abajo: las primeras guardan ids en variables que usan las demás.
#
# Convenciones
#   - Cada petición indica el código HTTP esperado en su título.
#   - Los nombres llevan {{$uuid}} para poder repetir las pruebas sin reiniciar.
#   - Los errores se devuelven como ProblemDetail (RFC 7807).
#
# Índice
#   0. Preparación/datos base
#   1. Categorías
#   2. Ingredientes
#   3. Recetas
#   4. Ingredientes de una receta
#   5. Borrados

@host = http://localhost:8080/api/v1

# 0. Preparación: crea una categoría, un ingrediente y una receta base

### 0.1 Crear categoría base (201)
POST {{host}}/categorias
Content-Type: application/json

{
  "nombre": "Platos principales {{$uuid}}",
  "descripcion": "Comidas fuertes"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Esperado 201, recibido " + response.status);
    });
    client.global.set("catId", response.body.id);
    client.global.set("catNombre", response.body.nombre);
%}

### 0.2 Crear ingrediente base (201)
POST {{host}}/ingredientes
Content-Type: application/json

{
  "nombre": "Arroz bomba {{$uuid}}"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Esperado 201, recibido " + response.status);
    });
    client.global.set("ingId", response.body.id);
    client.global.set("ingNombre", response.body.nombre);
%}

### 0.3 Crear receta base (201)
POST {{host}}/recetas
Content-Type: application/json

{
  "nombre": "Paella valenciana {{$uuid}}",
  "tiempoPreparacionMin": 90,
  "dificultad": "MEDIA",
  "categoriaId": {{catId}}
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Esperado 201, recibido " + response.status);
    });
    client.global.set("recId", response.body.id);
    client.global.set("recNombre", response.body.nombre);
%}

###############################################################################
# 1. CATEGORÍAS  (/api/v1/categorias)

### 1.1 Listar categorías (200)
GET {{host}}/categorias

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Esperado 200, recibido " + response.status);
    });
%}

### 1.2 Obtener categoría por id (200)
GET {{host}}/categorias/{{catId}}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Esperado 200, recibido " + response.status);
    });
%}

### 1.3 Obtener categoría inexistente (404 CategoriaNoEncontradaException)
GET {{host}}/categorias/999999

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "Esperado 404, recibido " + response.status);
    });
%}

### 1.4 Crear categoría con nombre vacío (400 validación, invalid-params)
POST {{host}}/categorias
Content-Type: application/json

{
  "nombre": "",
  "descripcion": "Sin nombre"
}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Esperado 400, recibido " + response.status);
    });
%}

### 1.5 Crear categoría con nombre duplicado (409 conflicto de integridad)
POST {{host}}/categorias
Content-Type: application/json

{
  "nombre": "{{catNombre}}",
  "descripcion": "Repetida"
}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Esperado 409, recibido " + response.status);
    });
%}

### 1.6 Editar categoría (200)
PUT {{host}}/categorias/{{catId}}
Content-Type: application/json

{
  "nombre": "{{catNombre}}",
  "descripcion": "Descripción actualizada"
}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Esperado 200, recibido " + response.status);
    });
%}

### 1.7 Editar categoría con datos inválidos (400)
PUT {{host}}/categorias/{{catId}}
Content-Type: application/json

