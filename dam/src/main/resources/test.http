POST {{host}}/recetas/{{recId}}/ingredientes
Content-Type: application/json

{}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Esperado 400, recibido " + response.status);
    });
%}

### 4.6 Añadir ingrediente con id negativo (400 @Positive)
POST {{host}}/recetas/{{recId}}/ingredientes
Content-Type: application/json

{
  "ingredienteId": -1
}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Esperado 400, recibido " + response.status);
    });
%}

### 4.7 Ver la receta con sus ingredientes (200 (debe salir 1 ingrediente)
GET {{host}}/recetas/{{recId}}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Esperado 200, recibido " + response.status);
    });
    client.test("Contiene 1 ingrediente", function () {
        client.assert(response.body.ingredientes.length === 1, "Ingredientes: " + response.body.ingredientes.length);
    });
%}

###############################################################################
# 5. BORRADOS (van al final porque eliminan los datos creados arriba)

### 5.1 Borrar categoría que aún tiene recetas (409)
DELETE {{host}}/categorias/{{catId}}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Esperado 409, recibido " + response.status);
    });
%}

### 5.2 Borrar receta (204)
DELETE {{host}}/recetas/{{recId}}

> {%
    client.test("204 No Content", function () {
        client.assert(response.status === 204, "Esperado 204, recibido " + response.status);
    });
%}

### 5.3 Borrar la misma receta otra vez (204 (el borrado es idempotente))
DELETE {{host}}/recetas/{{recId}}

> {%
    client.test("204 No Content", function () {
        client.assert(response.status === 204, "Esperado 204, recibido " + response.status);
    });
%}

### 5.4 Borrar categoría sin recetas (204)
DELETE {{host}}/categorias/{{catId}}

> {%
    client.test("204 No Content", function () {
        client.assert(response.status === 204, "Esperado 204, recibido " + response.status);
    });
%}

### 5.5 Comprobar que la categoría ya no existe (404)
GET {{host}}/categorias/{{catId}}

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "Esperado 404, recibido " + response.status);
    });
%}

