###############################################################################
# 4. INGREDIENTES DE UNA RECETA - RELACIÓN M:M
#    (/api/v1/recetas/{recetaId}/ingredientes)

### 4.1 Añadir ingrediente a la receta (201)
POST {{host}}/recetas/{{recId}}/ingredientes
Content-Type: application/json

{
  "ingredienteId": {{ingId}}
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "Esperado 201, recibido " + response.status);
    });
    client.test("La receta devuelve 1 ingrediente", function () {
        client.assert(response.body.ingredientes.length === 1, "Ingredientes: " + response.body.ingredientes.length);
    });
%}

### 4.2 Añadir el mismo ingrediente otra vez (409 IngredienteYaAnadidoException)
POST {{host}}/recetas/{{recId}}/ingredientes
Content-Type: application/json

{
  "ingredienteId": {{ingId}}
}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "Esperado 409, recibido " + response.status);
    });
%}

### 4.3 Añadir un ingrediente inexistente (404 IngredienteNoEncontradaException)
POST {{host}}/recetas/{{recId}}/ingredientes
Content-Type: application/json

{
  "ingredienteId": 999999
}

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "Esperado 404, recibido " + response.status);
    });
%}

### 4.4 Añadir ingrediente a una receta inexistente (404 RecetaNoEncontradaException)
POST {{host}}/recetas/999999/ingredientes
Content-Type: application/json

{
  "ingredienteId": {{ingId}}
}

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "Esperado 404, recibido " + response.status);
    });
%}

